# ============================================================
# 本地私密配置模板 —— 复制为 application-local.yml 并填入真实值
# 该文件已被 .gitignore 排除；后端以 fitness-backend 为工作目录启动时自动加载
# ============================================================
spring:
  datasource:
    username: root
    password: 你的数据库密码
    # Druid 监控台账号（可选覆盖；不写则用 application.yml 里的默认值 admin / admin123）
    # 监控台地址：http://localhost:8081/druid
    # druid:
    #   stat-view-servlet:
    #     login-username: admin
    #     login-password: 你的监控台密码

fitness:
  jwt:
    secret: 任意的长随机字符串（用于JWT签名）
  wechat:
    appid: 你的小程序AppID
    secret: 你的小程序AppSecret
